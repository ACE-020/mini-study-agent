# 复制为 deploy/.env 或直接写进 docker-compose 的环境变量
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-替换成你的密钥
OCR_MODEL=deepseek-flash
OCR_API_KEY=

WX_APPID=wx1234567890abcdef
WX_SECRET=替换成小程序后台的 AppSecret
WX_TOKEN_SECRET=用 openssl rand -base64 48 生成

WX_TOKEN_TTL_DAYS=7
WX_MAX_USERS=500
WX_CONTENT_CHECK=1

# 本地联调才设为 1；上线必须删掉
WX_DEV_LOGIN=0
# 微信云托管部署时设为 1（信任平台注入的 X-WX-OPENID）
WX_TRUST_CLOUD_HEADER=0
