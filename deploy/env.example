# 复制为 deploy/.env 或直接写进 docker-compose 的环境变量
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-替换成你的密钥
OCR_MODEL=deepseek-flash
OCR_API_KEY=

# 小程序 AppID / AppSecret：在「开发管理 → 开发设置」里取，只填在本机 deploy/.env，
# 不要写进仓库。这里故意留空：写 wx 开头的示例值会被 GitHub 密钥扫描当成真实 AppID。
WX_APPID=
WX_SECRET=

# 令牌签名密钥：openssl rand -base64 48 生成，换掉等于所有会话失效
WX_TOKEN_SECRET=

WX_TOKEN_TTL_DAYS=7
WX_MAX_USERS=500
WX_CONTENT_CHECK=1

# 本地联调才设为 1；上线必须删掉
WX_DEV_LOGIN=0
# 微信云托管部署时设为 1（信任平台注入的 X-WX-OPENID）
WX_TRUST_CLOUD_HEADER=0
# 云托管可选：只接受指定 X-WX-SOURCE（如 wx_client），未设置则信任任何来源
WX_TRUST_CLOUD_SOURCE=
